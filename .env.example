# Database (use values that match your MySQL — see dump.sql for fakedb on a remote host)
DB_HOST=localhost
DB_USER=root
DB_PASS=your_password
DB_NAME=fakedb
DB_PORT=3306

# If your data is on the host from dump.sql, use instead:
# DB_HOST=192.168.0.220
# DB_USER=user
# DB_PASS=1234
# DB_NAME=fakedb
# DB_PORT=3030

PORT=3002
GROQ_API_KEY=your_groq_api_key
